{
  "name": "twitch-talking-bot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node --watch src/server/index.js",
    "client": "npm run dev --prefix src/client",
    "migrate": "node src/server/db/migrate.js"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "connect-sqlite3": "^0.9.14",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-session": "^1.18.0",
    "node-fetch": "^2.7.0",
    "tmi.js": "^1.8.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "playwright": "^1.60.0"
  }
}
